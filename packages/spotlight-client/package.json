{
  "name": "@inupedia/spotlight-client",
  "version": "0.2.13",
  "description": "HTTP/SSE helpers and host tool bridge for Inupedia Spotlight (monorepo workspace package)",
  "type": "module",
  "license": "MIT",
  "author": "inupedia",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./agent-decorator": {
      "types": "./src/agentDecorator.d.ts"
    },
    "./agent-decorator-types": {
      "types": "./dist/agentDecoratorTypes.d.ts",
      "import": "./dist/agentDecoratorTypes.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/agentDecorator.d.ts"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.json && tsc -p tsconfig.node.json && pnpm run verify:exports",
    "verify:exports": "node ../scripts/verify-package-exports.mjs",
    "verify:skills-ref-oracle": "node scripts/verify-skills-ref-oracle.mjs",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@inupedia/spotlight-protocol": "workspace:*",
    "canonicalize": "3.0.0",
    "fflate": "0.8.3",
    "magic-string": "^0.30.21",
    "yaml": "^2.8.4"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
